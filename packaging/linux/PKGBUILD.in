# Maintainer: Emil Boenke <KimJongUnNK@users.noreply.github.com>
# AUR package "rekord-bin" – generated by the release pipeline (packaging/linux/build.sh)
pkgname=rekord-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc="Lokaler KI-Notizrekorder: aufnehmen, transkribieren, live erkennen wer spricht"
arch=('x86_64')
url="https://github.com/KimJongUnNK/rekord"
license=('MIT')
provides=('rekord')
conflicts=('rekord')
optdepends=('xdg-utils: Browser öffnen')
options=('!strip' '!debug')
source=("https://github.com/KimJongUnNK/rekord/releases/download/v${pkgver}/REKORD-${pkgver}-Linux-x86_64.tar.gz")
sha256sums=('@SHA256@')

package() {
  cd "rekord-${pkgver}"
  install -d "$pkgdir/opt" "$pkgdir/usr/bin"
  cp -a rekord "$pkgdir/opt/rekord"
  printf '#!/bin/sh\nexec /opt/rekord/REKORD "$@"\n' > "$pkgdir/usr/bin/rekord"
  chmod 755 "$pkgdir/usr/bin/rekord"
  install -Dm644 rekord.desktop "$pkgdir/usr/share/applications/rekord.desktop"
  install -Dm644 icons/256.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/rekord.png"
  install -Dm644 icons/512.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/rekord.png"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
